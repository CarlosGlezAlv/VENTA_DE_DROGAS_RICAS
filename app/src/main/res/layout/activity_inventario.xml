<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootInventario">

    <!-- Imagen de fondo -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/pantalla_de_carga" />

    <!-- Capa de fondo ajustable por el ConfigManager -->
    <View
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado con botón de volver -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnVolverInv"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/tvTituloPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUNTO DE VENTA"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_centerInParent="true" />
        </RelativeLayout>

        <!-- Sección de Búsqueda y Selección -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBusqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#22FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#44FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="#BBB"
                    app:hintTextColor="@android:color/white"
                    app:boxStrokeColor="@android:color/white"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <EditText
                        android:id="@+id/etCodigoInv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ingresar Código"
                        android:textColor="@android:color/white"
                        android:inputType="number"
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:drawablePadding="10dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvInfoProd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Producto: Esperando código..."
                    android:textColor="#00BCD4"
                    android:textSize="20sp"
                    android:layout_marginTop="12dp"
                    android:textStyle="bold|italic" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCantidad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColorHint="#BBB"
                        app:hintTextColor="@android:color/white"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <EditText
                            android:id="@+id/etCantidadVenta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Cantidad"
                            android:textColor="@android:color/white"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnAgregarAlCarrito"
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:layout_marginStart="12dp"
                        android:text="AÑADIR"
                        android:backgroundTint="#2196F3"
                        android:textStyle="bold"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSubtotalConsultado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subtotal Item: $0.00"
                    android:textColor="#FFEB3B"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="end" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Detalle de la Venta Actual -->
        <TextView
            android:id="@+id/tvCarritoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CARRITO DE COMPRAS"
            android:textColor="#AAA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCarrito"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#11FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#22FFFFFF">

            <ListView
                android:id="@+id/lvCarrito"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#22FFFFFF"
                android:dividerHeight="1dp"
                android:padding="8dp"
                android:clipToPadding="false" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Resumen Final -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#33000000"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTotalGeneral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TOTAL: $0.00"
                    android:textColor="#4CAF50"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnTerminarVenta"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="FINALIZAR VENTA"
                    android:backgroundTint="#4CAF50"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="30dp"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>